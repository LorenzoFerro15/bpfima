# Build directory - contains all compiled objects and executables
build/

# Kernel build system files (in case they end up in root)
*.cmd
.tmp_versions/

vmlinux.h
log.txt

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
**/bin/*
Dockerfile.cross

# Editor temporary files
*~
*.swp
*.swo
.*.swp
.*.swo
*.patch
*.pdf
out.txt
*.out

# Test binary, built with `go test -c`
*.test

# IDE files
.vscode/
.idea/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
*.backup
*.bak

# Log files
*.log

# Core dumps
core.*

# Temporary files
*.tmp
*tmp

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# Kubeconfig might contain secrets
*.kubeconfig