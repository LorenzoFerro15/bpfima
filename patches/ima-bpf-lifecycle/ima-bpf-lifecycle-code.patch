 {
+	bpf_ima_link_attach(primer->link, primer->id);
+
 	/* make bpf_link fetchable by ID */
 	spin_lock_bh(&link_idr_lock);
 	primer->link->id = primer->id;
@@ -5985,10 +5992,12 @@ static int link_update(union bpf_attr *attr)
 		goto out_put_progs;
 	}
 
 	if (link->ops->update_prog)
 		ret = link->ops->update_prog(link, new_prog, old_prog);
 	else
 		ret = -EINVAL;
+	if (!ret)
+		bpf_ima_link_update(link);
 
 out_put_progs:
 	if (old_prog)
@@ -6018,6 +6027,8 @@ static int link_detach(union bpf_attr *attr)
 		ret = link->ops->detach(link);
 	else
 		ret = -EOPNOTSUPP;
+	if (!ret)
+		bpf_ima_link_detach(link);
 
