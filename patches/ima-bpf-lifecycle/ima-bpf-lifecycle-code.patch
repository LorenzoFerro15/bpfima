diff --git a/kernel/bpf/ima.c b/kernel/bpf/ima.c
new file mode 100644
index 000000000..f769ac891
--- /dev/null
+++ b/kernel/bpf/ima.c
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Policy-controlled IMA measurements of BPF lifecycle operations. */
+#include <linux/bpf.h>
+#include <linux/ima.h>
+#include <linux/rcupdate.h>
+#include <crypto/sha2.h>
+
+#include "ima.h"
+
+static void bpf_ima_set_prog(struct bpf_ima_event *event,
+			     const struct bpf_prog *prog)
+{
+	const u8 *digest = NULL;
+
+	if (!prog)
+		return;
+	event->prog_id = cpu_to_le32(prog->aux->id);
+	event->prog_type = cpu_to_le32(prog->type);
+	event->attach_btf_id = cpu_to_le32(prog->aux->attach_btf_id);
+
+	if (bpf_prog_get_sig_digest(prog, &digest))
+		memcpy(event->prog_digest, digest, SHA256_DIGEST_SIZE);
+}
+
+static void bpf_ima_snapshot_prog(struct bpf_ima_event *event,
+				  const struct bpf_prog *prog)
+{
+	memset(event, 0, sizeof(*event));
+	event->attach_type = cpu_to_le32(prog->expected_attach_type);
+	bpf_ima_set_prog(event, prog);
+}
+
+static void bpf_ima_snapshot_link(struct bpf_ima_event *event,
+				  const struct bpf_link *link)
+{
+	memset(event, 0, sizeof(*event));
+	event->link_id = cpu_to_le32(link->id);
+	event->link_type = cpu_to_le32(link->type);
+	event->attach_type = cpu_to_le32(link->attach_type);
+	/* A concurrent link update may replace and put the old program. */
+	rcu_read_lock();
+	bpf_ima_set_prog(event, READ_ONCE(link->prog));
+	rcu_read_unlock();
+}
+
+void bpf_ima_prog_load(const struct bpf_prog *prog)
+{
+	struct bpf_ima_event event;
+
+	if (!prog || !ima_bpf_check_enabled())
+		return;
+	bpf_ima_snapshot_prog(&event, prog);
+	ima_measure_bpf_event("bpf_prog_load", &event, sizeof(event));
+}
+
+void bpf_ima_prog_unload(const struct bpf_prog *prog)
+{
+	struct bpf_ima_event event;
+
+	if (!prog || !prog->aux->sig.has_digest || !ima_bpf_check_enabled())
+		return;
+	bpf_ima_snapshot_prog(&event, prog);
+	ima_measure_bpf_event("bpf_prog_unload", &event, sizeof(event));
+}
+
+void bpf_ima_link_attach(const struct bpf_link *link, u32 id)
+{
+	struct bpf_ima_event event;
+
+	if (!link || !ima_bpf_check_enabled())
+		return;
+	bpf_ima_snapshot_link(&event, link);
+	event.link_id = cpu_to_le32(id);
+	ima_measure_bpf_event("bpf_link_attach", &event, sizeof(event));
+}
+
+void bpf_ima_link_update(const struct bpf_link *link)
+{
+	struct bpf_ima_event event;
+
+	if (!link || !ima_bpf_check_enabled())
+		return;
+	bpf_ima_snapshot_link(&event, link);
+	ima_measure_bpf_event("bpf_link_update_prog", &event, sizeof(event));
+}
+
+void bpf_ima_link_detach(const struct bpf_link *link)
+{
+	struct bpf_ima_event event;
+
+	if (!link || !ima_bpf_check_enabled())
+		return;
+	bpf_ima_snapshot_link(&event, link);
+	ima_measure_bpf_event("bpf_link_detach", &event, sizeof(event));
+}
+
+void bpf_ima_link_release(const struct bpf_link *link)
+{
+	struct bpf_ima_event event;
+
+	if (!link || !link->id || !ima_bpf_check_enabled())
+		return;
+	bpf_ima_snapshot_link(&event, link);
+	ima_measure_bpf_event("bpf_link_release", &event, sizeof(event));
+}
diff --git a/kernel/bpf/ima.h b/kernel/bpf/ima.h
new file mode 100644
index 000000000..f1f4082dc
--- /dev/null
+++ b/kernel/bpf/ima.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _BPF_IMA_H
+#define _BPF_IMA_H
+
+#include <linux/bpf.h>
+#include <crypto/sha2.h>
+
+/* Little-endian fields, no pointers or implicit padding. */
+struct bpf_ima_event {
+	__le32 prog_id;
+	__le32 prog_type;
+	__le32 attach_btf_id;
+	__le32 link_id;
+	__le32 link_type;
+	__le32 attach_type;
+	u8 prog_digest[SHA256_DIGEST_SIZE];
+};
+
+static_assert(sizeof(struct bpf_ima_event) == 56);
+
+#ifdef CONFIG_IMA
+void bpf_ima_prog_load(const struct bpf_prog *prog);
+void bpf_ima_prog_unload(const struct bpf_prog *prog);
+void bpf_ima_link_attach(const struct bpf_link *link, u32 id);
+void bpf_ima_link_update(const struct bpf_link *link);
+void bpf_ima_link_detach(const struct bpf_link *link);
+void bpf_ima_link_release(const struct bpf_link *link);
+#else
+static inline void bpf_ima_prog_load(const struct bpf_prog *prog) {}
+static inline void bpf_ima_prog_unload(const struct bpf_prog *prog) {}
+static inline void bpf_ima_link_attach(const struct bpf_link *link, u32 id) {}
+static inline void bpf_ima_link_update(const struct bpf_link *link) {}
+static inline void bpf_ima_link_detach(const struct bpf_link *link) {}
+static inline void bpf_ima_link_release(const struct bpf_link *link) {}
+#endif
+
+#endif /* _BPF_IMA_H */
