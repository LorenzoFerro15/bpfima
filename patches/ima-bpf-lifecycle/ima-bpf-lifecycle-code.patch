 	return ret;
diff --git a/kernel/bpf/verifier.c b/kernel/bpf/verifier.c
index 5f874979b..29df50420 100644
--- a/kernel/bpf/verifier.c
+++ b/kernel/bpf/verifier.c
@@ -33,6 +33,8 @@
 #include <net/xdp.h>
 #include <linux/trace_events.h>
 #include <linux/kallsyms.h>
+#include <linux/ima.h>
+#include <crypto/sha2.h>
 
 #include "diagnostics.h"
 #include "disasm.h"
@@ -21086,101 +21088,150 @@ static enum bpf_sig_keyring bpf_classify_keyring(s32 keyring_id)
  * each map, in @maps order: insns || map_0 || map_1 || [...]. On success the
  * verdict and keyring info are recorded on prog->aux.
  */
+static int bpf_map_check_canonical_rodata(struct bpf_verifier_env *env,
+					  struct bpf_map *map, bool strict)
+{
+	if (map->map_type != BPF_MAP_TYPE_ARRAY ||
+	    !map->ops->map_direct_value_addr) {
+		if (strict)
+			verbose(env, "signed program metadata map '%s' must be an array\n",
+				map->name);
+		return -EINVAL;
+	}
+	if (!READ_ONCE(map->frozen)) {
+		if (strict)
+			verbose(env, "signed program metadata map '%s' must be frozen\n",
+				map->name);
+		return -EPERM;
+	}
+	if (bpf_map_write_active(map)) {
+		if (strict)
+			verbose(env, "signed program metadata map '%s' has active writers\n",
+				map->name);
+		return -EBUSY;
+	}
+	if (strict && !map->excl_prog_sha) {
+		verbose(env, "signed program metadata map '%s' must be exclusive\n",
+			map->name);
+		return -EPERM;
+	}
+	return 0;
+}
+
+static int bpf_prog_calc_canonical_payload(struct bpf_verifier_env *env,
+					   void **out_data, u64 *out_sz)
+{
+	struct bpf_prog *prog = env->prog;
+	struct bpf_map **maps = env->used_maps;
+	u32 map_cnt = env->used_map_cnt;
+	u32 i, off, insns_sz;
+	u64 data_sz;
+	void *data;
+	int err;
+
+	if (prog->aux->sig.has_digest)
+		return 0;
+
+	insns_sz = prog->len * sizeof(struct bpf_insn);
+	if (!out_data) {
+		struct sha256_ctx sctx;
+
+		sha256_init(&sctx);
+		sha256_update(&sctx, (const u8 *)prog->insnsi, insns_sz);
+		for (i = 0; i < map_cnt; i++) {
+			struct bpf_map *map = maps[i];
+			u64 addr;
+
+			if (bpf_map_check_canonical_rodata(env, map, false))
+				continue;
+			if (map->ops->map_direct_value_addr(map, &addr, 0))
+				continue;
+			sha256_update(&sctx, (const u8 *)(unsigned long)addr,
+				      map->value_size);
+		}
+		sha256_final(&sctx, prog->aux->sig.digest);
+		prog->aux->sig.has_digest = true;
+		prog->aux->sig.verdict = BPF_SIG_UNSIGNED;
+		return 0;
+	}
+
+	data_sz = insns_sz;
+	for (i = 0; i < map_cnt; i++) {
+		err = bpf_map_check_canonical_rodata(env, maps[i], true);
+		if (err)
+			return err;
+		data_sz += maps[i]->value_size;
+	}
+	if (bpf_dynptr_check_size(data_sz)) {
+		verbose(env, "signed payload too large: %llu bytes\n", data_sz);
+		return -E2BIG;
+	}
+
+	data = kvmalloc(data_sz, GFP_KERNEL_ACCOUNT | __GFP_ZERO);
+	if (!data)
+		return -ENOMEM;
+
+	memcpy(data, prog->insnsi, insns_sz);
+	off = insns_sz;
+	for (i = 0; i < map_cnt; i++) {
+		struct bpf_map *map = maps[i];
+		u64 addr;
+
+		err = map->ops->map_direct_value_addr(map, &addr, 0);
+		if (err) {
+			verbose(env, "failed to read signed metadata map '%s': %d\n",
+				map->name, err);
+			kvfree(data);
+			return err;
+		}
+		memcpy(data + off, (void *)(unsigned long)addr, map->value_size);
+		off += map->value_size;
+	}
+
+	sha256(data, data_sz, prog->aux->sig.digest);
+	prog->aux->sig.has_digest = true;
+	*out_data = data;
+	*out_sz = data_sz;
+	return 0;
+}
