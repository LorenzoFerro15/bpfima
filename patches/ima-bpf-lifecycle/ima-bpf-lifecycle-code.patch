+/**
+ * ima_bpf_check_enabled - Check if BPF_CHECK measurement is enabled by policy
+ *
+ * Return true if IMA policy contains a matching measure rule for BPF_CHECK,
+ * false otherwise.
+ */
+bool ima_bpf_check_enabled(void)
+{
+	struct ima_template_desc *template;
+	struct lsm_prop prop;
+	int action, pcr = 0;
+
+	if (!(READ_ONCE(ima_policy_flag) & IMA_MEASURE))
+		return false;
+
+	template = ima_template_desc_buf();
+	security_current_getlsmprop_subj(&prop);
